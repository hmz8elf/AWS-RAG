# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Groq API key used by the LLM (Llama 3.3 70B) — read in config/settings.py
GROQ_API_KEY=your-groq-api-key

# AWS region — read in config/settings.py (defaults to eu-west-1)
AWS_REGION=eu-west-1

# S3 bucket holding the prebuilt FAISS indexes (indexes/ prefix), used by the CI workflow
S3_BUCKET_NAME=your-bucket-name

# Run mode (cli_local | web, see config/mode.py) — not read by the code yet
MODE=cli_local

# Base URL of the FastAPI backend used by the CLI (defaults to http://localhost:8000)
EC2_URL=http://localhost:8000
